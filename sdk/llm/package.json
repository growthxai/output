{
  "name": "@outputai/llm",
  "version": "0.14.0",
  "description": "Framework abstraction to interact with LLM models",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "./src/!(*.spec).js",
    "./src/index.d.ts",
    "./src/prompt/!(*.spec).js",
    "./src/prompt/markup/!(*.spec).js",
    "./src/utils/!(*.spec).js",
    "./src/utils/*.json"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p ./tsconfig.typecheck.json",
    "take-models-pricing-snapshot": "node ./scripts/take_models_pricing_snapshot.js"
  },
  "dependencies": {
    "@outputai/core": "workspace:",
    "decimal.js": "10.6.0",
    "entities": "8.1.0",
    "gray-matter": "4.0.3",
    "liquidjs": "10.29.0",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.94",
    "@ai-sdk/anthropic": "4.0.63",
    "@ai-sdk/azure": "4.0.79",
    "@ai-sdk/google-vertex": "5.0.93",
    "@ai-sdk/openai": "4.0.75",
    "@ai-sdk/perplexity": "4.0.50",
    "ai": "7.0.114"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": ">=5 <6",
    "@ai-sdk/anthropic": ">=4 <5",
    "@ai-sdk/azure": ">=4 <5",
    "@ai-sdk/google-vertex": ">=5 <6",
    "@ai-sdk/openai": ">=4 <5",
    "@ai-sdk/perplexity": ">=4 <5",
    "ai": ">=7 <8"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
