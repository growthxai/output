{
  "name": "@outputai/core",
  "version": "0.15.0",
  "description": "The core module of the output framework",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./hooks": {
      "types": "./src/hooks/index.d.ts",
      "import": "./src/hooks/index.js"
    },
    "./temporal": {
      "types": "./src/temporal/index.d.ts",
      "import": "./src/temporal/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "import": "./dist/credentials/index.js"
    },
    "./http": {
      "types": "./src/http/index.d.ts",
      "import": "./src/http/index.js"
    },
    "./llm": {
      "types": "./src/llm/index.d.ts",
      "import": "./src/llm/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "import": "./dist/evals/index.js"
    }
  },
  "files": [
    "./src",
    "./dist",
    "./bin",
    "!**/*.spec.*",
    "!src/credentials",
    "!src/evals",
    "!src/llm/fixtures"
  ],
  "bin": {
    "output-worker": "./bin/worker.sh",
    "outputai": "./bin/worker.sh",
    "output-healthcheck": "./bin/healthcheck.mjs",
    "output-copy-assets": "./bin/copy_assets.js"
  },
  "scripts": {
    "worker": "node ./src/worker/index.js",
    "build": "rm -rf ./dist && tsc && pnpm exec tsc -p ./tsconfig.typecheck.json",
    "take-models-pricing-snapshot": "node ./scripts/take_models_pricing_snapshot.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "3.1138.0",
    "@babel/generator": "7.29.1",
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.0",
    "@babel/types": "7.29.0",
    "@noble/ciphers": "2.4.0",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "decimal.js": "10.6.0",
    "entities": "8.1.0",
    "folder-hash": "4.1.3",
    "gray-matter": "4.0.3",
    "js-yaml": "catalog:",
    "json-stream-stringify": "3.1.7",
    "liquidjs": "10.29.0",
    "redis": "5.12.1",
    "stacktrace-parser": "0.1.11",
    "winston": "catalog:"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5",
    "ky": ">=2 <3",
    "undici": ">=8.12.2 <9",
    "ai": ">=7 <8",
    "@ai-sdk/amazon-bedrock": ">=5 <6",
    "@ai-sdk/anthropic": ">=4 <5",
    "@ai-sdk/azure": ">=4 <5",
    "@ai-sdk/google-vertex": ">=5 <6",
    "@ai-sdk/openai": ">=4 <5",
    "@ai-sdk/perplexity": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/amazon-bedrock": { "optional": true },
    "@ai-sdk/anthropic": { "optional": true },
    "@ai-sdk/azure": { "optional": true },
    "@ai-sdk/google-vertex": { "optional": true },
    "@ai-sdk/openai": { "optional": true },
    "@ai-sdk/perplexity": { "optional": true }
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "zod": "catalog:",
    "ky": "catalog:",
    "undici": "catalog:",
    "ai": "7.0.112",
    "@ai-sdk/amazon-bedrock": "5.0.92",
    "@ai-sdk/anthropic": "4.0.61",
    "@ai-sdk/azure": "4.0.77",
    "@ai-sdk/google-vertex": "5.0.91",
    "@ai-sdk/openai": "4.0.73",
    "@ai-sdk/perplexity": "4.0.49"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#bus": "./src/bus.js",
    "#consts": "./src/consts.js",
    "#credentials/*": "./dist/credentials/*.js",
    "#errors": "./src/errors.js",
    "#logger": "./src/logger/index.js",
    "#runtime_logger": "./src/interface/logger.js",
    "#hooks/*": "./src/hooks/*.js",
    "#helpers/*": "./src/helpers/*.js",
    "#interface/*": "./src/interface/*.js",
    "#tracing": "./src/tracing/internal_interface.js",
    "#trace_attribute": "./src/tracing/trace_attribute.js",
    "#async_storage": "./src/async_storage.js",
    "#temporal/*": "./src/temporal/*.js",
    "#internal_activities": "./src/internal_activities/index.js"
  }
}
