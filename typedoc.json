{
  "entryPoints": [
    "./sdk/core/src/hooks/index.d.ts",
    "./sdk/core/src/index.d.ts",
    "./sdk/core/src/credentials/index.ts",
    "./sdk/core/src/evals/index.ts",
    "./sdk/core/src/http/index.d.ts",
    "./sdk/core/src/temporal/index.d.ts",
    "./sdk/core/src/llm/index.d.ts"
  ],
  "entryPointStrategy": "resolve",
  "excludeExternals": true,
  "intentionallyNotExported": [
    "@outputai/core/src/interface/types.d.ts:AnyZodSchema",
    "@outputai/core/src/interface/types.d.ts:DeepPartial",
    "@outputai/core/src/llm/index.d.ts:DefaultRuntimeContext",
    "@outputai/core/src/llm/index.d.ts:WithoutToolSchemaBrands"
  ],
  "skipErrorChecking": true,
  "disableSources": true,
  "outputs": [
    {
      "name": "html",
      "path": "./docs/reference",
      "options": {
        "navigation": {
          "includeCategories": true,
          "includeGroups": true,
          "excludeReferences": false,
          "includeFolders": true
        }
      }
    }
  ],
  "theme": "default",
  "readme": "none"
}
